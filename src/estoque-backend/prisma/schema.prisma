generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ---------------------------------------------------------------
// Hierarquia do sistema:
//   admin -> coordenador -> professor -> aluno
//
// - admin: único que pode criar contas de coordenador.
// - coordenador: cria/gerencia professores e materiais.
// - professor: cria/gerencia alunos; aprova/recusa solicitações de item.
// - aluno: loga com RM + email + senha; só acessa a tela "Solicitações"
//   (pedir materiais/EPIs e acompanhar os pedidos).
// ---------------------------------------------------------------
enum Role {
  admin
  coordenador
  professor
  aluno
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   // agora obrigatório, sem valor padrão — toda conta

  // precisa nascer com um papel explícito, escolhido por quem a criou.

  // Só é preenchido para quem é aluno (Registro do Aluno / matrícula).
  rm String? @unique

  // Quem criou/gerencia esta conta:
  //   admin       -> criou o coordenador
  //   coordenador -> criou o professor
  //   professor   -> criou o aluno
  // Fica nulo só pro(s) admin(s), que não têm "dono".
  criadoPorId Int?
  criadoPor   User?  @relation("HierarquiaUsuarios", fields: [criadoPorId], references: [id])
  gerenciados User[] @relation("HierarquiaUsuarios")

  createdAt DateTime @default(now())

  // Conta desativada não consegue entrar (nem continuar logada), mas o
  // histórico dela (movimentações, aprovações...) é preservado.
  ativo Boolean @default(true)

  // Tokens (logins) emitidos ANTES desta data deixam de valer. Preenchido
  // quando a senha é redefinida e quando a conta é desativada/reativada,
  // para encerrar sessões antigas na hora.
  tokensValidosDesde DateTime?

  materiaisCriados         Material[]
  movimentacoesRegistradas Movimentacao[]

  // Solicitações que o aluno fez e solicitações que esta pessoa
  // (professor/coordenador/admin) aprovou ou recusou.
  solicitacoesFeitas      Solicitacao[] @relation("SolicitacaoAluno")
  solicitacoesRespondidas Solicitacao[] @relation("SolicitacaoResponsavel")

  // Empréstimos de uniforme que o aluno fez e devoluções que esta pessoa
  // (professor/coordenador/admin) recebeu.
  emprestimosFeitos      Emprestimo[] @relation("EmprestimoAluno")
  emprestimosRecebidos   Emprestimo[] @relation("EmprestimoRecebedor")
  // Pedidos de empréstimo que esta pessoa aprovou ou recusou.
  emprestimosRespondidos Emprestimo[] @relation("EmprestimoResponsavel")
}

model Material {
  id              Int       @id @default(autoincrement())
  nome            String
  categoria       String    // "EPI" | "Uniforme" | "Outro"
  unidadeMedida   String    // "Unidade" | "Caixa" | "Pacote" ou nome customizado
  fatorConversao  Int       @default(1) // unidades dentro de 1 "unidadeMedida"

  // FONTE DA VERDADE do estoque, SEMPRE em unidades. A API deriva daqui
  // "embalagens fechadas" e "unidades avulsas" (ver src/lib/quantidade.js),
  // então é possível retirar 1 unidade de um item que vem em caixa.
  quantidadeTotal Int       @default(0)

  // O aluno pode pedir unidade avulsa de um item que vem em embalagem?
  // (Desligue para material estéril, kits fechados etc.) A equipe sempre
  // pode movimentar por unidade.
  permiteFracionar Boolean  @default(true)

  // Estoque mínimo, em EMBALAGENS (a mesma "unidadeMedida", ex: caixas).
  // Quando quantidadeTotal <= estoqueMinimo * fatorConversao, a tela de
  // Estoque destaca o item como "Estoque baixo". 0 = sem alerta.
  estoqueMinimo   Int       @default(0)
  validade        DateTime? @db.Date
  ca              String?
  ativo           Boolean   @default(true)

  // Quem cadastrou o material (normalmente um coordenador).
  criadoPorId Int?
  criadoPor   User? @relation(fields: [criadoPorId], references: [id])

  movimentacoes Movimentacao[]
  solicitacoes  Solicitacao[]
  emprestimos   Emprestimo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Histórico de entradas (colocar de volta), saídas (retirar) e devoluções
// de estoque. Cada ação de retirar/devolver em um Material cria um registro
// aqui, guardando quem fez (responsavel) e quando (createdAt).
//   entrada   -> material colocado/reposto no estoque
//   saida     -> material retirado do estoque
//   devolucao -> uniforme emprestado que voltou ao estoque (empréstimo
//                devolvido). Também aumenta o estoque, mas aparece separado
//                em Movimentações pra não se confundir com uma reposição.
enum TipoMovimentacao {
  entrada
  saida
  devolucao
}

model Movimentacao {
  id         Int              @id @default(autoincrement())
  tipo       TipoMovimentacao
  quantidade Int              // em UNIDADES

  materialId Int
  // Restrict: não deixa excluir um Material que já tem movimentações
  // (o controller trata esse erro e orienta a inativar em vez de excluir).
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  responsavelId Int
  // Restrict: não deixa excluir um usuário que já registrou movimentações
  // (preserva o histórico de quem mexeu no estoque).
  responsavel   User @relation(fields: [responsavelId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------
// Solicitações de material feitas pelo aluno.
//
// Fluxo:
//   pendente -> aprovada   (professor/coordenador/admin aprova: o estoque
//                           é baixado e uma Movimentacao de saída é criada)
//
// O aluno só pode solicitar EPI. Uniforme ele só consegue pegar por
// EMPRÉSTIMO (ver model Emprestimo, mais abaixo).
//   pendente -> recusada   (com motivo opcional)
//   pendente -> cancelada  (o próprio aluno desiste)
//
// Quem responder primeiro encerra o pedido: depois disso ninguém mais
// consegue aprovar/recusar (ver solicitacao.controller.js).
// ---------------------------------------------------------------
enum StatusSolicitacao {
  pendente
  aprovada
  recusada
  cancelada
}

model Solicitacao {
  id         Int               @id @default(autoincrement())
  quantidade Int               // em UNIDADES
  observacao String?
  status     StatusSolicitacao @default(pendente)

  // Preenchido quando o pedido é recusado (opcional).
  motivoRecusa String?

  alunoId Int
  // Cascade: se a conta do aluno for excluída, os pedidos dele vão junto.
  // (O que já foi retirado do estoque continua registrado em Movimentacao.)
  aluno   User @relation("SolicitacaoAluno", fields: [alunoId], references: [id], onDelete: Cascade)

  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  // Quem aprovou/recusou e quando (nulo enquanto estiver pendente/cancelada).
  respondidoPorId Int?
  respondidoPor   User?     @relation("SolicitacaoResponsavel", fields: [respondidoPorId], references: [id], onDelete: Restrict)
  respondidoEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alunoId])
  @@index([status])
}

// ---------------------------------------------------------------
// Empréstimos de uniforme (aluno).
//
// O aluno PEDE o empréstimo e ele só vale depois que um professor,
// coordenador ou admin CONFIRMA:
//   pendente   -> pedido feito, aguardando confirmação. O estoque NÃO
//                 muda e nenhuma Movimentacao é criada ainda.
//   emprestado -> alguém da equipe confirmou: o estoque é baixado e uma
//                 Movimentacao de saída é criada (em nome de quem
//                 confirmou), tudo numa transação.
//   recusado   -> a equipe recusou (com motivo opcional).
//   cancelado  -> o próprio aluno desistiu enquanto estava pendente.
//   devolvido  -> professor/coordenador/admin confirma que recebeu o
//                 uniforme de volta: o estoque volta e uma Movimentacao
//                 de devolução é criada (em nome de quem recebeu).
//
// Quem responder primeiro encerra o pedido (ver emprestimo.controller.js).
//
// "Atrasado" não é um status gravado: é calculado — empréstimo ainda
// "emprestado" cuja dataDevolucaoPrevista já passou (ver
// emprestimo.controller.js). Assim nunca fica desatualizado.
// ---------------------------------------------------------------
enum StatusEmprestimo {
  pendente
  emprestado
  devolvido
  recusado
  cancelado
}

model Emprestimo {
  id         Int              @id @default(autoincrement())
  quantidade Int              // em UNIDADES
  observacao String?
  status     StatusEmprestimo @default(pendente)

  // Dia combinado para devolver (só a data, sem hora).
  dataDevolucaoPrevista DateTime @db.Date

  // Preenchidos quando o pedido é confirmado ou recusado pela equipe.
  motivoRecusa    String?
  respondidoPorId Int?
  respondidoPor   User?     @relation("EmprestimoResponsavel", fields: [respondidoPorId], references: [id], onDelete: Restrict)
  respondidoEm    DateTime?

  // Preenchidos quando o uniforme volta.
  devolvidoEm   DateTime?
  recebidoPorId Int?
  recebidoPor   User?     @relation("EmprestimoRecebedor", fields: [recebidoPorId], references: [id], onDelete: Restrict)

  alunoId Int
  // Restrict: não deixa excluir um aluno que tem empréstimo registrado
  // (o uniforme saiu do estoque em nome dele).
  aluno   User @relation("EmprestimoAluno", fields: [alunoId], references: [id], onDelete: Restrict)

  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alunoId])
  @@index([status, dataDevolucaoPrevista])
}
