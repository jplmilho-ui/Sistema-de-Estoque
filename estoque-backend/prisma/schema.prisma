generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de usuário, usado pelo cadastro e login.
// Quando você for evoluir o sistema de estoque, os modelos de Produto,
// Categoria etc. entram aqui embaixo, do mesmo jeito.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
