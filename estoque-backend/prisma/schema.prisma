generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de usuário, usado pelo cadastro e login.
// Quando você for evoluir o sistema de estoque, os modelos de Produto,
// Categoria etc. entram aqui embaixo, do mesmo jeito.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  // "user" (padrão, quem se cadastra sozinho) ou "admin" (só quem já é
  // admin pode promover outra pessoa, pela tela de Gerenciar usuários).
  role      String   @default("user")
  createdAt DateTime @default(now())
}
